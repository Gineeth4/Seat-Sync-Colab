{
  "_type": "Project",
  "_id": "PRJ_SEQ",
  "name": "Smart Seat Sync Sequence Diagram",
  "ownedElements": [
    {
      "_type": "UMLModel",
      "_id": "MDL_SEQ",
      "_parent": { "$ref": "PRJ_SEQ" },
      "name": "Sequence Model",
      "ownedElements": [
        {
          "_type": "UMLCollaboration",
          "_id": "COL1",
          "_parent": { "$ref": "MDL_SEQ" },
          "name": "OccupancyDetectionFlow",
          "ownedElements": [
            {
              "_type": "UMLInteraction",
              "_id": "INT1",
              "_parent": { "$ref": "COL1" },
              "name": "detect_occupancy",
              "participants": [
                { "_type": "UMLLifeline", "_id": "LL_CAM",  "_parent": { "$ref": "INT1" }, "name": "Camera" },
                { "_type": "UMLLifeline", "_id": "LL_ENG",  "_parent": { "$ref": "INT1" }, "name": "OccupancyEngine" },
                { "_type": "UMLLifeline", "_id": "LL_YOLO", "_parent": { "$ref": "INT1" }, "name": "YOLOv8" },
                { "_type": "UMLLifeline", "_id": "LL_GEO",  "_parent": { "$ref": "INT1" }, "name": "GeometryModule" },
                { "_type": "UMLLifeline", "_id": "LL_API",  "_parent": { "$ref": "INT1" }, "name": "FastAPI" },
                { "_type": "UMLLifeline", "_id": "LL_DASH", "_parent": { "$ref": "INT1" }, "name": "Dashboard" }
              ],
              "messages": [
                { "_type": "UMLMessage", "_id": "MSG1", "_parent": { "$ref": "INT1" }, "name": "start_inference(frame)",         "source": { "$ref": "LL_CAM" },  "target": { "$ref": "LL_ENG" },  "messageSort": "synchCall" },
                { "_type": "UMLMessage", "_id": "MSG2", "_parent": { "$ref": "INT1" }, "name": "detect(frame)",                  "source": { "$ref": "LL_ENG" },  "target": { "$ref": "LL_YOLO" }, "messageSort": "synchCall" },
                { "_type": "UMLMessage", "_id": "MSG3", "_parent": { "$ref": "INT1" }, "name": "detections[]",                   "source": { "$ref": "LL_YOLO" }, "target": { "$ref": "LL_ENG" },  "messageSort": "reply" },
                { "_type": "UMLMessage", "_id": "MSG4", "_parent": { "$ref": "INT1" }, "name": "match_seats(detections, seats)", "source": { "$ref": "LL_ENG" },  "target": { "$ref": "LL_GEO" },  "messageSort": "synchCall" },
                { "_type": "UMLMessage", "_id": "MSG5", "_parent": { "$ref": "INT1" }, "name": "seat_statuses[]",                "source": { "$ref": "LL_GEO" },  "target": { "$ref": "LL_ENG" },  "messageSort": "reply" },
                { "_type": "UMLMessage", "_id": "MSG6", "_parent": { "$ref": "INT1" }, "name": "push(OccupancyResult)",          "source": { "$ref": "LL_ENG" },  "target": { "$ref": "LL_API" },  "messageSort": "asynchCall" },
                { "_type": "UMLMessage", "_id": "MSG7", "_parent": { "$ref": "INT1" }, "name": "ws.send(result)",                "source": { "$ref": "LL_API" },  "target": { "$ref": "LL_DASH" }, "messageSort": "asynchCall" }
              ]
            },
            {
              "_type": "UMLSequenceDiagram",
              "_id": "DGM_SEQ",
              "_parent": { "$ref": "COL1" },
              "name": "Occupancy Detection Flow",
              "ownedViews": [

                {
                  "_type": "UMLSeqLifelineView",
                  "_id": "V_LL_CAM",
                  "_parent": { "$ref": "DGM_SEQ" },
                  "model": { "$ref": "LL_CAM" },
                  "left": 60, "top": 20, "width": 100, "height": 560
                },

                {
                  "_type": "UMLSeqLifelineView",
                  "_id": "V_LL_ENG",
                  "_parent": { "$ref": "DGM_SEQ" },
                  "model": { "$ref": "LL_ENG" },
                  "left": 220, "top": 20, "width": 140, "height": 560
                },

                {
                  "_type": "UMLSeqLifelineView",
                  "_id": "V_LL_YOLO",
                  "_parent": { "$ref": "DGM_SEQ" },
                  "model": { "$ref": "LL_YOLO" },
                  "left": 420, "top": 20, "width": 100, "height": 560
                },

                {
                  "_type": "UMLSeqLifelineView",
                  "_id": "V_LL_GEO",
                  "_parent": { "$ref": "DGM_SEQ" },
                  "model": { "$ref": "LL_GEO" },
                  "left": 580, "top": 20, "width": 140, "height": 560
                },

                {
                  "_type": "UMLSeqLifelineView",
                  "_id": "V_LL_API",
                  "_parent": { "$ref": "DGM_SEQ" },
                  "model": { "$ref": "LL_API" },
                  "left": 780, "top": 20, "width": 100, "height": 560
                },

                {
                  "_type": "UMLSeqLifelineView",
                  "_id": "V_LL_DASH",
                  "_parent": { "$ref": "DGM_SEQ" },
                  "model": { "$ref": "LL_DASH" },
                  "left": 940, "top": 20, "width": 100, "height": 560
                }

              ]
            }
          ]
        }
      ]
    }
  ]
}
